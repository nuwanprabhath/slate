{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slate:schema:vault-header:3",
  "title": "Slate vault header v3 (vault.json)",
  "description": "Roadmap docs/reviews/quantum-proof-roadmap.md §3.2-§3.3. Header v2 plus a required `pq` object and room for hybrid ML-KEM device slots (`device-<uuid>`, at most 18 wraps in all). parseHeaderV3 (packages/desktop/src/main/vault/header.ts) accepts exactly the documents this schema accepts that also keep semantic rules 1-8: rules 1-3 as v2 (the salt decodes canonically to 16-64 bytes; fips-140-3 requires pbkdf2-hmac-sha512 and standard argon2id; history epochs are distinct and below keyEpoch); rule 4, 64 KiB; rule 5, pq.kem is hybrid-only; rule 6, pq.minCapability is at least 2 when any device slot is present; rule 7, each device slot's kemCt and ecdhPub are canonical base64 of exactly 1088 and 32 bytes (mlkem768-x25519-kdf56c) or 1568 and 97 bytes with a leading 0x04 (mlkem1024-p384-kdf56c); rule 8, fips-140-3 allows only mlkem1024-p384-kdf56c slots; and at most 16 device slots (§3.2: the schema bounds only all wraps together). Rules 9-10 (wrap AAD continuity, device slot carry-through) are about writing, not parsing. The kdf, salt, wrap and history definitions are v2's, verbatim. Guarded by tools/guards/headerSchema.test.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "vaultId", "revision", "createdAt", "profile", "suite", "keyEpoch", "kdf", "wraps", "pq", "check"],
  "properties": {
    "format": { "const": "slate-vault" },
    "version": { "const": 3 },
    "vaultId": { "$ref": "#/$defs/uuid" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "createdAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "profile": { "enum": ["standard", "fips-140-3"] },
    "suite": { "const": 2 },
    "keyEpoch": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "kdf": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["alg", "memoryKiB", "passes", "parallelism", "salt"],
          "properties": {
            "alg": { "const": "argon2id" },
            "memoryKiB": { "type": "integer", "minimum": 65536, "maximum": 1048576 },
            "passes": { "type": "integer", "minimum": 2, "maximum": 10 },
            "parallelism": { "const": 1 },
            "salt": { "$ref": "#/$defs/salt" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["alg", "iterations", "salt"],
          "properties": {
            "alg": { "const": "pbkdf2-hmac-sha512" },
            "iterations": { "type": "integer", "minimum": 600000, "maximum": 10000000 },
            "salt": { "$ref": "#/$defs/salt" }
          }
        }
      ]
    },
    "wraps": {
      "type": "object",
      "required": ["password"],
      "maxProperties": 18,
      "properties": { "password": { "$ref": "#/$defs/wrap" }, "recovery": { "$ref": "#/$defs/wrap" } },
      "patternProperties": { "^device-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$": { "$ref": "#/$defs/deviceWrap" } },
      "additionalProperties": false
    },
    "history": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/history" } },
    "pq": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kem", "minCapability"],
      "properties": { "kem": { "const": "hybrid-only" }, "minCapability": { "type": "integer", "minimum": 1, "maximum": 255 } }
    },
    "check": { "type": "string", "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$" }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "b64": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
    "salt": { "type": "string", "minLength": 24, "maxLength": 88, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
    "wrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "nonce", "ct"],
      "properties": {
        "alg": { "const": "aes-256-gcm" },
        "nonce": { "type": "string", "pattern": "^[A-Za-z0-9+/]{16}$" },
        "ct": { "type": "string", "pattern": "^[A-Za-z0-9+/]{64}$" }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epoch", "alg", "nonce", "ct"],
      "properties": {
        "epoch": { "type": "integer", "minimum": 0, "maximum": 4294967294 },
        "alg": { "const": "aes-256-gcm" },
        "nonce": { "type": "string", "pattern": "^[A-Za-z0-9+/]{16}$" },
        "ct": { "type": "string", "pattern": "^[A-Za-z0-9+/]{64}$" }
      }
    },
    "deviceWrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "pkHash", "kemCt", "ecdhPub", "nonce", "ct", "addedAt", "addedBy"],
      "properties": {
        "alg": { "enum": ["mlkem768-x25519-kdf56c", "mlkem1024-p384-kdf56c"] },
        "pkHash": { "type": "string", "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$" },
        "kemCt": { "allOf": [{ "$ref": "#/$defs/b64" }, { "minLength": 1452, "maxLength": 2092 }] },
        "ecdhPub": { "allOf": [{ "$ref": "#/$defs/b64" }, { "minLength": 44, "maxLength": 132 }] },
        "nonce": { "type": "string", "pattern": "^[A-Za-z0-9+/]{16}$" },
        "ct": { "type": "string", "pattern": "^[A-Za-z0-9+/]{64}$" },
        "addedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "addedBy": { "$ref": "#/$defs/uuid" }
      }
    }
  }
}
