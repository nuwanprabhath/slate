#!/bin/sh
# A commit on a detached HEAD belongs to no branch: the next checkout leaves it behind.
# Rebase and cherry-pick detach on purpose and finish on a branch, so they are let through.
if ! git symbolic-ref -q HEAD >/dev/null; then
  gitdir=$(git rev-parse --git-dir)
  if [ ! -d "$gitdir/rebase-merge" ] && [ ! -d "$gitdir/rebase-apply" ] && [ ! -f "$gitdir/CHERRY_PICK_HEAD" ]; then
    echo "pre-commit: HEAD is detached, so this commit would belong to no branch." >&2
    echo "  Switch to a branch first (git switch <branch> or git switch -c <name>)." >&2
    exit 1
  fi
fi

# Lint the staged TypeScript and ESM files with the slate/* guard rules (CLAUDE.md, Guardrails).
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.mjs')
if [ -n "$files" ]; then
  eslint="$(git rev-parse --show-toplevel)/tools/lint/node_modules/.bin/eslint"
  if [ ! -x "$eslint" ]; then
    echo "pre-commit: the lint toolchain is missing; run npm install (it installs tools/lint)." >&2
    exit 1
  fi
  # One argument per file: paths in this repo have no spaces.
  # shellcheck disable=SC2086
  if ! "$eslint" --max-warnings 0 --no-warn-ignored $files; then
    echo "pre-commit: fix the lint errors above; each slate/* message names the accepted path." >&2
    exit 1
  fi
fi
